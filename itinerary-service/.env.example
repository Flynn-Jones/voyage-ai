# Standalone Compose: pass --env-file itinerary-service/.env (copy this example).
AI_ENABLED=true
MCP_ENABLED=true
MCP_SERVICE_URL=http://host.docker.internal:7001
MCP_TIMEOUT_SECONDS=30
RAG_ENABLED=true
RAG_SERVICE_URL=http://host.docker.internal:7002
RAG_TIMEOUT_SECONDS=120
# Configuration only: enable after the Student 5 Multi-Agent workflow is implemented.
MULTI_AGENT_ENABLED=false
MULTI_AGENT_SERVICE_URL=http://host.docker.internal:7004
MULTI_AGENT_TIMEOUT_SECONDS=240
# Cloud baseline: set AI_ENABLED, MCP_ENABLED, RAG_ENABLED and MULTI_AGENT_ENABLED=false.
# Root Compose uses ITINERARY_ prefixes for all settings above, e.g. ITINERARY_AI_ENABLED.
# Host Python processes use localhost URLs; backend flags are read when its app is created
# (existing MCP/RAG flags continue to be read per request).
