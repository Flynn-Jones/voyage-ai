# Standalone Compose: pass --env-file itinerary-service/.env (copy this example).
MCP_ENABLED=true
MCP_SERVICE_URL=http://host.docker.internal:7001
MCP_TIMEOUT_SECONDS=30
RAG_ENABLED=true
RAG_SERVICE_URL=http://host.docker.internal:7002
RAG_TIMEOUT_SECONDS=120
# Root Compose uses ITINERARY_ prefixes for these six variables to avoid
# changing another student's service. Host Python processes use localhost URLs.
