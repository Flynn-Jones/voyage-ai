# Shared, non-containerised AI services (run on the host; see README "Start the shared AI servers").
# Copy into a feature's .env / compose `environment:`; never commit a real .env.
#
# From inside a container use host.docker.internal; from the host use localhost.
MCP_SERVICE_URL=http://host.docker.internal:7001/mcp
RAG_SERVICE_URL=http://host.docker.internal:7002
MULTI_AGENT_SERVICE_URL=http://host.docker.internal:7004
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Feature switches: true locally, false in the cloud (AWS sets these to false).
MCP_ENABLED=true
RAG_ENABLED=true
MULTI_AGENT_ENABLED=true
AI_ENABLED=true

# Multi-Agent Server itself (all optional)
# MULTI_AGENT_PORT=7004
# OLLAMA_TIMEOUT_SECONDS=60
