# Activity Manager (student-3): configuration reference only.
#
# Lists the variables activity-service/docker-compose.yml reads through
# ${VAR:-default}, with those defaults. Copy it to activity-service/.env to
# override any of them. Never commit a real .env (it is .gitignore'd); none of
# these values are secret, they are local URLs, model tags and on/off flags.

# Ollama, for AI Mode (summaries and chat), reached from the backend container.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Shared MCP (:7001), RAG (:7002) and Multi-Agent (:7004) servers from
# ai-services/, run on the host, not in Docker. Setting an *_ENABLED flag to
# false turns that mode's /api/activity/<mode>/* routes into a 403.
ACTIVITY_MCP_SERVICE_URL=http://host.docker.internal:7001
ACTIVITY_MCP_ENABLED=true
ACTIVITY_RAG_SERVICE_URL=http://host.docker.internal:7002
ACTIVITY_RAG_ENABLED=true
ACTIVITY_MULTI_AGENT_SERVICE_URL=http://host.docker.internal:7004
ACTIVITY_MULTI_AGENT_ENABLED=true
