# Destination Manager (student-1) — configuration reference only.
#
# This file documents the environment variable NAMES the Session 4 Ollama
# comparison feature reads. It is not loaded automatically by
# docker-compose.yml — copy it to student-1/.env if you want to override the
# defaults baked into docker-compose.yml's ${VAR:-default} interpolation.
#
# Never commit a real .env (it is already .gitignore'd) and never put
# secrets here — none of these values are secret, they are local URLs and a
# model tag.

# Base URL the destination-backend container uses to reach Ollama. On a Mac
# running Ollama on the host (not in a container), the Docker-to-host address
# is host.docker.internal, paired with the extra_hosts host-gateway entry in
# docker-compose.yml.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model tag, must be present in `ollama list` on the machine running Ollama.
# qwen2.5:0.5b is the fast default used for demo reliability (small, quick
# responses). For higher-quality output when speed isn't critical, swap to
# llama3.1:8b (also installed) — expect noticeably slower responses.
OLLAMA_MODEL=qwen2.5:0.5b

# Read timeout (seconds) for the single Ollama /api/chat call.
OLLAMA_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Release 1 — shared MCP and RAG (host-local, NOT Compose services)
# ---------------------------------------------------------------------------
# The shared MCP (:7001) and RAG (:7002) servers and Ollama run directly on the
# host. destination-backend reaches them via host.docker.internal.

# Compose-level on/off switches. Both docker-compose.yml files (student-1 and
# the root one) read these from the shell or an uncommitted .env beside the
# compose file; unset means enabled. Student 1 CI sets both to false so it
# never depends on host-local AI services.
DESTINATION_MCP_ENABLED=true
DESTINATION_RAG_ENABLED=true

# Frontend -> backend read timeouts in seconds (destination-frontend). Keep
# them above the backend's own MCP/RAG timeouts below so the backend's
# structured timeout response reaches the UI first. Non-numeric, zero or
# negative values fall back to these defaults.
MCP_REQUEST_TIMEOUT_SECONDS=15
RAG_REQUEST_TIMEOUT_SECONDS=130

# Reference only — fixed in both docker-compose.yml files for
# destination-backend, not overridable from .env:
#   MCP_SERVICE_URL=http://host.docker.internal:7001
#   MCP_TIMEOUT_SECONDS=10
#   RAG_SERVICE_URL=http://host.docker.internal:7002
#   RAG_TIMEOUT_SECONDS=120
# (The backend also reads MCP_ENABLED / RAG_ENABLED; Compose sets them from
# DESTINATION_MCP_ENABLED / DESTINATION_RAG_ENABLED above.)
